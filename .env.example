# Copy to .env and fill only the values needed for the script you are running.
# Never commit .env. A script that lacks a key it needs says which one and stops.

# Zotero Web API (zotero-knowledge-base). Create a key at zotero.org/settings/keys/new
# with library read and write; the numeric user id is shown on the same page.
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# The running Zotero client's local API, for read-only audits without a key.
# Enable it under Settings, Advanced. This is the default when unset.
# ZOTERO_LOCAL_API=http://127.0.0.1:23119/api/users/0

# An address for the Crossref and OpenAlex polite pools (faster, fewer refusals).
CROSSREF_MAILTO=

# Embeddings for the semantic index. One is enough: DeepInfra is used when its
# key is present, otherwise OpenRouter (the same Qwen3-Embedding-8B space).
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=

# Chat synthesis for zotero_ask.py, cite_suggest.py and zotero_enrich.py generate.
OPENROUTER_MODEL=qwen/qwen3.7-max
# OPENROUTER_REASONING=on   # keep a reasoning model's reasoning; off by default, since these are grounded summaries

# Any OpenAI-compatible embeddings endpoint instead of the two above.
# EMBED_PROVIDER=custom
# EMBED_URL=
# EMBED_API_KEY=
# EMBED_MODEL=
